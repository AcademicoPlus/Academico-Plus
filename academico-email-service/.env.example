SERVER_PORT=8081

# RabbitMQ (local: docker-compose do academico-backend; produção: URL do CloudAMQP)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_SSL_ENABLED=false

# Resend API
EMAIL_FROM=Academico+ <nao-responda@academicomais.com.br>
RESEND_API_KEY=your_resend_api_key_here
RESEND_API_URL=https://api.resend.com/emails

LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_UNIFAPI_ACADEMICO_EMAIL=DEBUG
