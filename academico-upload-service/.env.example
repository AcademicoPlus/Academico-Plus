SERVER_PORT=8082

# Chave compartilhada com o monolito (header X-Internal-Api-Key) — gere uma string aleatória.
INTERNAL_API_KEY=changeme-shared-secret

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_UNIFAPI_ACADEMICO_UPLOAD=DEBUG
