
# Database
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# JWT
JWT_SECRET=
JWT_EXPIRATION=

# Server
SERVER_PORT=8080
SERVER_SERVLET_CONTEXT_PATH=
SPRING_APPLICATION_NAME=

# academico-upload-service (fotos de perfil)
UPLOAD_SERVICE_URL=http://localhost:8082
UPLOAD_SERVICE_API_KEY=changeme-shared-secret

# RabbitMQ (mesmas credenciais do docker-compose.yml / CloudAMQP em produção)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_SSL_ENABLED=false

# Primeiro admin: e-mail de uma conta JA CADASTRADA, promovida a ADMIN no
# proximo start. Deixe vazio em dev. Ver DEPLOY.md, secao "Primeiro admin".
ADMIN_BOOTSTRAP_EMAIL=

# Swagger: "true" em dev para abrir /swagger-ui.html. Deixe vazio/false em
# producao - a doc fica publica sem autenticacao.
SWAGGER_ENABLED=true

# Rate limiting (opcional - os padroes do application.properties ja servem)
RATE_LIMIT_REQUISICOES_POR_MINUTO=120
RATE_LIMIT_CADASTROS_POR_HORA=10

# CORS
CORS_ALLOWED_ORIGINS=

# Logging
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_UNIFAPI_ACADEMICO=

# Profile
SPRING_PROFILES_ACTIVE=